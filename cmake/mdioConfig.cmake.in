@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/mdioTargets.cmake")

# Aliases are not part of an export set, so re-create the public monolith alias
# for installed consumers. Link mdio::monolith for ODR-safe co-loading.
if(TARGET mdio::mdio_monolith_interface AND NOT TARGET mdio::monolith)
  add_library(mdio::monolith INTERFACE IMPORTED)
  set_target_properties(mdio::monolith PROPERTIES
    INTERFACE_LINK_LIBRARIES mdio::mdio_monolith_interface)
endif()